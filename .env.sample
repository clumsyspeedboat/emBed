################################################################################
# Sample Environment for emBed
#
# Copy to .env and fill in your secrets. This sample includes all tunables
# and explanations. Keep the variable set identical between .env and
# .env.sample; only add your access secrets in .env.
################################################################################

##############################################
# 1) Storage: MinIO/S3 Connection & Security #
##############################################
# Endpoint: URL to your MinIO/S3 service. Include scheme.
MINIO_ENDPOINT=https://YOUR_MINIO_ENDPOINT:9000

# Region and buckets (comma-separated) for listing/health displays.
MINIO_REGION=us-east-1
MINIO_BUCKETS=your-bucket

# Credentials (leave blank in sample; set in .env only)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SESSION_TOKEN=

# TLS and addressing behavior
# - MINIO_VERIFY: false allows self-signed certs (HTTPS to IPs)
# - MINIO_ALLOW_HTTP: true only if using http:// endpoints
# - Path vs. virtual host style addressing (IP-based endpoints prefer path-style)
MINIO_VERIFY=True
MINIO_ALLOW_HTTP=False
MINIO_FORCE_PATH_STYLE=True
MINIO_VIRTUAL_HOSTED_STYLE=False
# Optional: suppress HTTPS warnings when verify=false
MINIO_SUPPRESS_TLS_WARN=0

##############################################
# 2) Vector Store: LanceDB Location         #
##############################################
# Use a local directory (fastest) or an S3 URI (s3://bucket/prefix)
LANCEDB_URI=s3://your-bucket/lancedb

#############################################################
# 3) Query-Time Search Quality vs. Latency (ANN parameters) #
#############################################################
# Metric: l2 | cosine | dot (dot maps to cosine for unit-normalized vectors)
LANCEDB_METRIC=l2
# IVF partitions to probe per query (higher → better recall, slower)
LANCEDB_NPROBES=32
# Re-rank with exact distances on this many candidates
LANCEDB_REFINE_FACTOR=50

############################
# 4) Embedding Configuration
############################
# Backend: real | dummy (dummy = ultra-fast, deterministic vectors)
EMBEDDING_BACKEND=real
# To align text/image spaces, use CLIP for both
TEXT_MODEL=clip:ViT-B-32
IMAGE_MODEL=ViT-B-32
# Device: auto | cuda | cpu
DEVICE=auto

###########################
# 5) Web App Configuration
###########################
# Default table to query; UI options, image previews, and CORS
WEBAPP_TABLE=multimodal
WEBAPP_SHOW_IMAGES=1
WEBAPP_MAX_UPLOAD_BYTES=8388608  # 8 MiB
WEBAPP_CORS_ORIGINS=*
WEBAPP_PRESIGN_TTL=3600
WEBAPP_ALLOW_LIDAR=1
# Optional: set WEBAPP_DEFAULT_METRIC to override UI default; otherwise uses LANCEDB_METRIC
# WEBAPP_DEFAULT_METRIC=l2


###########################################
# 6) Ingestion Performance & Logging Knobs
###########################################
# Concurrency for S3 downloads; batch sizes for embedding; write chunk size.
INGEST_WORKERS=32
INGEST_EMBED_BATCH=128
# LiDAR batch: explicit size; if 0 or unset, uses INGEST_EMBED_BATCH // LIDAR_BATCH_DIVISOR
LIDAR_EMBED_BATCH=32
LIDAR_BATCH_DIVISOR=8
INGEST_WRITE_CHUNK=10000
# PDF text extraction work per doc
INGEST_PDF_MAX_PAGES=6
# Progress printing frequency (0 = per-batch); raise to reduce console noise
INGEST_PROGRESS_EVERY=0
