## MinIO and LanceDB configuration
# Replace the values below with your actual credentials when deploying to a real
# environment. These are placeholders for local development.

MINIO_ENDPOINT=https://s3api.aimotions1.rz.fh-ingolstadt.de
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=

# Comma-separated list of bucket names that may be used
MINIO_BUCKETS=aimotion-private-embed


LANCEDB_URI=s3://aimotion-private-embed/lancedb